{
  "name": "obsidian-site-v3",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --config .config/vite.config.ts --port 3000",
    "build": "vite build --config .config/vite.config.ts",
    "preview": "pnpm run build && vite preview --config .config/vite.config.ts",
    "deploy": "pnpm run build && wrangler deploy",
    "cf-typegen": "wrangler types --config .config/wrangler.jsonc",
    "generate-routes": "tsr generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config .config/vitest.config.ts",
    "test:watch": "vitest --config .config/vitest.config.ts",
    "fmt": "oxfmt --config .config/oxfmt.config.ts . '!src/routeTree.gen.ts'",
    "fmt:check": "oxfmt --config .config/oxfmt.config.ts --check . '!src/routeTree.gen.ts'",
    "lint": "oxlint --config .config/oxlint.config.ts --fix",
    "lint:check": "oxlint --config .config/oxlint.config.ts",
    "changeset": "changeset",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o dist/storybook"
  },
  "dependencies": {
    "@saintly-software/baritone": "1.0.0-alpha.8",
    "@tanstack/react-router": "1.170.38",
    "@tanstack/react-start": "1.168.57",
    "@tanstack/router-plugin": "1.168.40",
    "@vanilla-extract/css": "1.21.2",
    "hast-util-to-jsx-runtime": "2.3.6",
    "lucide-react": "1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@cloudflare/vite-plugin": "1.57.3",
    "@storybook/react-vite": "10.6.0",
    "@tanstack/router-cli": "1.167.38",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "22.20.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "gray-matter": "4.0.3",
    "jsdom": "30.1.1",
    "katex": "0.18.7",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "rehype-katex": "7.0.1",
    "rehype-raw": "7.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "storybook": "10.6.0",
    "typescript": "6.0.3",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "vfile": "6.0.3",
    "vite": "8.3.0",
    "vitest": "4.1.10",
    "wrangler": "4.136.3"
  },
  "engines": {
    "node": "26.1.0",
    "pnpm": "11.1.2"
  },
  "packageManager": "pnpm@11.1.2"
}
