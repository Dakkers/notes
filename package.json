{
  "name": "obsidian-site-v3",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --config .config/vite.config.ts --port 3000",
    "build": "vite build --config .config/vite.config.ts",
    "preview": "pnpm run build && vite preview --config .config/vite.config.ts",
    "deploy": "pnpm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "generate-routes": "tsr generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config .config/vitest.config.ts",
    "test:watch": "vitest --config .config/vitest.config.ts",
    "fmt": "oxfmt --config .config/oxfmt.config.ts . '!src/routeTree.gen.ts'",
    "fmt:check": "oxfmt --config .config/oxfmt.config.ts --check . '!src/routeTree.gen.ts'",
    "lint": "oxlint --config .config/oxlint.config.ts --fix",
    "lint:check": "oxlint --config .config/oxlint.config.ts",
    "changeset": "changeset"
  },
  "dependencies": {
    "@saintly-software/baritone": "1.0.0-alpha.2",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-start": "1.168.30",
    "@tanstack/router-plugin": "1.168.19",
    "@vanilla-extract/css": "1.21.1",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "lucide-react": "^1.30.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@cloudflare/vite-plugin": "^1.51.0",
    "@tanstack/router-cli": "1.167.18",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "gray-matter": "^4.0.3",
    "katex": "^0.18.1",
    "oxfmt": "0.50.0",
    "oxlint": "1.64.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "typescript": "6.0.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vfile": "^6.0.3",
    "vite": "8.1.4",
    "vitest": "4.1.10",
    "wrangler": "^4.119.0"
  },
  "engines": {
    "node": "26.1.0",
    "pnpm": "11.1.2"
  },
  "packageManager": "pnpm@11.1.2"
}
